{
  // 執行方式：Ctrl+Shift+P →「Tasks: Run Task」→ 選擇工作；或按 F5 一次啟動全部（見 launch.json）
  // 停止：在終端機面板對該工作按垃圾桶，或 Ctrl+Shift+P →「Tasks: Terminate Task」
  "version": "2.0.0",
  "tasks": [
    {
      "label": "POC：全部啟動",
      "detail": "依序啟動 MongoDB、後端（8090）、前端（5173）",
      "dependsOn": ["MongoDB：啟動", "後端：啟動", "前端：啟動"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "MongoDB：啟動",
      "detail": "docker compose up，等到 replica set 就緒",
      "type": "shell",
      "command": "docker compose up -d --wait",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "group": "poc", "reveal": "silent" }
    },
    {
      "label": "MongoDB：停止",
      "type": "shell",
      "command": "docker compose stop",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "MongoDB：重設資料",
      "detail": "刪除所有資料後重新建立；後端下次啟動會重新寫入初始設定（請先停止後端）",
      "type": "shell",
      "command": "docker compose down -v; docker compose up -d --wait",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "後端：啟動",
      "detail": "mvnw spring-boot:run，http://localhost:8090（8090 已在使用時略過）",
      "type": "shell",
      // 已在執行時略過，否則第二次 F5 會因 port 被占用以 exit code 1 結束，瀏覽器不會開啟
      "command": "if (Get-NetTCPConnection -State Listen -LocalPort 8090 -ErrorAction SilentlyContinue) { Write-Host 'Port 8090 already in use, skip starting backend' } else { .\\mvnw.cmd spring-boot:run }",
      "options": { "cwd": "${workspaceFolder}/backend", "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "isBackground": true,
      "problemMatcher": {
        "owner": "poc-backend",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "Scanning for projects|Starting CopilotApplication",
          "endsPattern": "Started CopilotApplication|APPLICATION FAILED TO START|BUILD FAILURE|skip starting backend"
        }
      },
      "presentation": { "group": "poc", "reveal": "always" }
    },
    {
      "label": "前端：啟動",
      "detail": "npm run dev，http://localhost:5173（5173 已在使用時略過）",
      "type": "shell",
      // 已在執行時略過，否則 Vite 會改用 5174，瀏覽器仍開 5173
      "command": "if (Get-NetTCPConnection -State Listen -LocalPort 5173 -ErrorAction SilentlyContinue) { Write-Host 'Port 5173 already in use, skip starting frontend' } else { npm run dev }",
      "options": { "cwd": "${workspaceFolder}/frontend", "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "isBackground": true,
      "problemMatcher": {
        "owner": "poc-frontend",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "vite|VITE",
          "endsPattern": "ready in|Local|skip starting frontend"
        }
      },
      "presentation": { "group": "poc", "reveal": "always" }
    },
    {
      "label": "前端：安裝套件",
      "detail": "第一次執行或 package.json 改變時需要",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "測試：後端",
      "type": "shell",
      "command": ".\\mvnw.cmd test",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "測試：前端",
      "detail": "單元測試與型別檢查 + 建置",
      "type": "shell",
      "command": "npm test; if ($?) { npm run build }",
      "options": { "cwd": "${workspaceFolder}/frontend", "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "查看稽核紀錄（最新 5 筆）",
      "type": "shell",
      "command": "docker compose exec mongo mongosh copilot --quiet --eval \"db.COLL_ICRM_AI_ASSISTANT_AUDIT.find({}, {_id:0, userId:1, customerId:1, question:1, createdAt:1}).sort({createdAt:-1}).limit(5)\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
