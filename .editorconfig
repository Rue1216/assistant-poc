# https://editorconfig.org
root = true

# 全域設定
[*]
charset = utf-8
end-of-line = lf
insert-final-newline = true
trim-trailing-whitespace = true
indent_style = space
indent_size = 4

# 前端: TS/Vue/JS (2 space)
[*.{ts,tsx,vue,js,mjs,cjs}]
indent_size = 2

# 前端: HTML/CSS/SCSS (2 space)
[*.{html,css,scss}]
indent_size = 2

# 設定檔: JSON/YAML (2 space)
[*.{json,yml,yaml}]
indent_size = 2

# 後端: Java / xml (4 space)
[*.java]
indent_size = 4

[*.xml]
indent_size = 4

# markdown (保留尾行空格，因為 markdown 需要尾行空格換行)
[*.md]
trim-trailing-whitespace = false

# makefile (使用 tab 縮排)
[Makefile]
indent_style = tab